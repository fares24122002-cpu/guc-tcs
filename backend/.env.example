# Copy to backend/.env and fill in. NEVER commit the real file.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (no trailing slash).
# Production example: https://guc-tcs.vercel.app
CORS_ORIGINS=http://localhost:5173

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public anon key (used only for user sign-in on the server)
SUPABASE_ANON_KEY=
# SECRET service-role key. Server only. Never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Private storage bucket for participant photos
SUPABASE_PHOTO_BUCKET=participant-photos

# Staff log in with a username. Supabase needs an email, so one is derived as username@<domain>.
# No email is ever sent. Do not change this after accounts exist.
STAFF_EMAIL_DOMAIN=staff.guc-tcs.test

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
# requests per window, per signed-in user
RATE_LIMIT_MAX=120
# coarse per-IP flood guard (high on purpose: all staff share the venue Wi-Fi)
RATE_LIMIT_IP_MAX=1500
